{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/playable-lie/mould.schema.json",
  "title": "Playable Lie Sprite Mould",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "canvas", "frames", "animations"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "default": "0.1"},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "transparent": {"type": "boolean", "default": true}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "width", "height", "anchor"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "x": {"type": "integer", "minimum": 0},
          "y": {"type": "integer", "minimum": 0},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"}
            }
          },
          "mask": {"type": ["string", "null"]}
        }
      }
    },
    "animations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frames", "fps"],
        "properties": {
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "fps": {"type": "number", "exclusiveMinimum": 0},
          "loop": {"type": "boolean", "default": true}
        }
      }
    },
    "palette": {
      "type": ["array", "null"],
      "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"}
    }
  }
}
